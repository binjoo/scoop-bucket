{
    "version": "3.16.3",
    "description": "Z.ai's coding agent harness. Powerful, intelligent, extensible.",
    "homepage": "https://github.com/zai-org/ZCode",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zai-org/ZCode/releases/download/v3.16.3/ZCode-3.16.3-win-x64.exe#/dl.7z",
            "hash": "b4fccc1ead9922d9066e083d53d3bf92bdeac3124767d4352fd0583e5399382f"
        },
        "arm64": {
            "url": "https://github.com/zai-org/ZCode/releases/download/v3.16.3/ZCode-3.16.3-win-arm64.exe#/dl.7z",
            "hash": "2e7f4ec1c7349b66e6447ef548289d677cdbafe60756c50654367c53c5ed44d6"
        }
    },
    "installer": {
        "script": [
            "Get-Item -Path \"$dir\\`$PLUGINSDIR\\app*.7z\" | Expand-7zipArchive -DestinationPath \"$dir\"",
            "Remove-Item -Path \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -Force"
        ]
    },
    "post_install": [
        "# Disable built-in update mechanism to prevent conflicts with Scoop's update management",
        "$yaml = \"$dir\\resources\\app-update.yml\"",
        "$content = Get-Content -Path $yaml | Foreach-Object {",
        "    if ($_.StartsWith('url')) { \"$($_.Replace('url', '# url')) # Disabled by Scoop\" } else { $_ }",
        "}",
        "Set-Content $yaml -Value $content -Encoding ascii"
    ],
    "shortcuts": [
        [
            "ZCode.exe",
            "ZCode"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zai-org/ZCode/releases/download/v$version/ZCode-$version-win-x64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/zai-org/ZCode/releases/download/v$version/ZCode-$version-win-arm64.exe#/dl.7z"
            }
        }
    }
}
