    "architecture": {
        "64bit": {
            "url": "https://github.com/zai-org/ZCode/releases/download/v3.17.1/ZCode-3.17.1-win-x64.exe#/dl.7z",
            "hash": "d9c21c5472f7357daf429dbfbb6b4ec8f77c83ecc13aa9fde7583b0c328e6cef"
        },
        "arm64": {
            "url": "https://github.com/zai-org/ZCode/releases/download/v3.17.1/ZCode-3.17.1-win-arm64.exe#/dl.7z",
            "hash": "670bf5ce97e15c159f54ab37a0810a9aa947033f06c1104531c1631c824ed7ce"
        }
    },
    "installer": {
        "script": [
            "Get-Item -Path \"$dir\\`$PLUGINSDIR\\app*.7z\" | Expand-7zipArchive -DestinationPath \"$dir\"",
            "Remove-Item -Path \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -Force"
        ]
    },
    "post_install": [
        "# Disable built-in update mechanism to prevent conflicts with Scoop's update management",
        "$yaml = \"$dir\\resources\\app-update.yml\"",
        "$content = Get-Content -Path $yaml | Foreach-Object {",
        "    if ($_.StartsWith('url')) { \"$($_.Replace('url', '# url')) # Disabled by Scoop\" } else { $_ }",
        "}",
        "Set-Content $yaml -Value $content -Encoding ascii"
    ],
    "shortcuts": [
        [
            "ZCode.exe",
            "ZCode"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zai-org/ZCode/releases/download/v$version/ZCode-$version-win-x64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/zai-org/ZCode/releases/download/v$version/ZCode-$version-win-arm64.exe#/dl.7z"
            }
        }
    }
}
